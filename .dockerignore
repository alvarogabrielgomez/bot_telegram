# Dependencies — installed fresh inside the image
node_modules/

# Environment / secrets — injected at runtime, never baked into the image
.env
.env.local
.env.*.local

# VCS
.git/
.gitignore

# Docs / spec — not needed at runtime
README.md
docs/
telegram-ollama-bot-spec.md
openapi.json

# Agent runtime data — lives in the bot-data volume, never in the image
data/

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Docker
.dockerignore
Dockerfile
docker-compose.yml
observability/
